# {{ ansible_managed }}
{# Spring selects environment-specific behavior from the inventory profile. #}
SPRING_PROFILES_ACTIVE={{ app_profile }}
{# Keeping the port explicit makes the service and verification agree. #}
SERVER_PORT={{ app_port }}
{# An optional color supports demonstrations without adding an empty setting. #}
{% if app_color | length > 0 %}
APP_COLOR="{{ app_color }}"
{% endif %}
